# dci was explicitly selected for SiteWork on 29 October 2026.
DECIONIS_API_BASE=https://api.decionis.com
DECIONIS_GATEWAY_URL=https://dci.decionisedge.com
DECIONIS_ORG_ID=124e5022-6eee-4717-ab65-a03899db6237
# These are separate secrets. Public health is not an API-key check.
AGENTSAFE_TENANT_KEY=
DECIONIS_API_KEY=
# Separate decision:enforce credential for ENFORCEMENT/PARALLEL gate calls.
# DECIONIS_API_KEY remains the read/SHADOW credential, including dossier reads.
DECIONIS_ENFORCE_API_KEY=
# Separate authoring credential: policy:read and policy:write.
# Use directly with DECIONIS_API_BASE, never as the gateway runtime credential.
DECIONIS_POLICY_API_KEY=
DECIONIS_MODE=live
DECIONIS_GATE_MODE=ENFORCEMENT
COSMOS_REASON_URL=
